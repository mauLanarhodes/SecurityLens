# Copy to .env, chmod 600 .env, and fill the required secrets locally.
# See docs/pilot-setup.md. Never commit credentials or expose them as VITE_*.

# Required: generate each independently with `openssl rand -hex 32`.
# Use hex for POSTGRES_PASSWORD so it is safe inside the Compose database URL.
POSTGRES_PASSWORD=
AUTH_OPERATOR_TOKEN=
# Optional read-only access; generate a different token if enabling it.
AUTH_VIEWER_TOKEN=

# false is only for localhost HTTP, including an SSH tunnel to localhost.
# Use true with HTTPS on a private network. Compose defaults to true if omitted.
AUTH_COOKIE_SECURE=false

# Live LLM (triage / investigation / rule-generation).
# Keep the key in this backend-only file; never commit .env.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Empty uses gpt-6.1-sol for OpenAI, claude-opus-4-8 for Anthropic.
LLM_MODEL=
# auto = live if the selected provider's key is present, else mock.
# live = require a key; mock = stay offline even if a key is present.
LLM_MODE=mock
# Optional alternative: set LLM_PROVIDER=anthropic and supply this key.
ANTHROPIC_API_KEY=

# Pilot starts empty; enable seeding only in a separate synthetic demo stack.
SEED_ON_START=false
SEED_LOGS=200000
SEED_DAYS=21
SEED_SEED=1
