# Copy to .env and edit. All values are optional — the defaults run the full
# stack with the deterministic mock LLM and a 200k-log seeded dataset.

# Live LLM (triage / investigation / rule-generation). Empty = mock.
ANTHROPIC_API_KEY=
# auto = live if a key is present else mock; force with mock | live
LLM_MODE=auto

# Synthetic dataset seeded on first boot.
SEED_LOGS=200000
SEED_DAYS=21
SEED_SEED=1
